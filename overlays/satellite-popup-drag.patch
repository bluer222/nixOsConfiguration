 /// See Pointer::handle_event for an explanation.
 #[test]
 fn popup_pointer_motion_workaround() {}
+
+#[test]
+fn popup_drag_keeps_pointer_root_position() {
+    use wayland_server::protocol::wl_pointer::ButtonState;
+    for scale in [1.0, 2.0] {
+        let (mut f, comp) = TestFixture::new_with_compositor();
+        let pointer =
+            TestObject::<WlPointer>::from_request(&comp.seat.obj, wl_seat::Request::GetPointer {});
+        let (_, output) = f.new_output(0, 0);
+        output.scale(scale as i32);
+        output.done();
+        f.run();
+        f.run();
+        let toplevel = Window::new(1);
+        let (_, t_id) = f.create_toplevel(&comp, toplevel);
+        f.testwl.move_surface_to_output(t_id, &output);
+        f.run();
+        let popup = Window::new(2);
+        let (_, p_id) =
+            f.create_popup(&comp, PopupBuilder::new(popup, toplevel, t_id).scale(scale));
+        f.testwl.move_pointer_to(p_id, 5.0, 5.0);
+        f.run();
+        f.testwl
+            .pointer()
+            .button(25, 0, 0x110, ButtonState::Pressed);
+        f.testwl.dispatch();
+        f.run();
+        f.run();
+
+        for delta in [4, 8, 12] {
+            let dims = WindowDims {
+                x: delta,
+                y: delta,
+                width: 50,
+                height: 50,
+            };
+            f.reconfigure_window(popup, dims, true);
+            f.run();
+            f.run();
+            // Smithay keeps motion relative to the popup's button-down position.
+            f.testwl
+                .pointer()
+                .motion(1, 5.0 + delta as f64 / scale, 5.0 + delta as f64 / scale);
+            f.testwl.dispatch();
+            f.run();
+            f.run();
+            let events = std::mem::take(&mut *pointer.data.events.lock().unwrap());
+            let coords = events
+                .into_iter()
+                .find_map(|e| match e {
+                    wayland_client::protocol::wl_pointer::Event::Motion {
+                        surface_x,
+                        surface_y,
+                        ..
+                    } => Some((surface_x, surface_y)),
+                    _ => None,
+                })
+                .expect("pointer motion missing");
+            assert_eq!(coords, (5.0 * scale, 5.0 * scale));
+        }
+        f.testwl
+            .pointer()
+            .button(26, 2, 0x110, ButtonState::Released);
+        f.testwl.dispatch();
+        f.run();
+        f.run();
+        f.testwl.pointer().motion(3, 5.0, 5.0);
+        f.testwl.dispatch();
+        f.run();
+        f.run();
+        assert!(
+            pointer
+                .data
+                .events
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|e| matches!(e,
+            wayland_client::protocol::wl_pointer::Event::Motion { surface_x, surface_y, .. }
+            if *surface_x == 5.0 * scale && *surface_y == 5.0 * scale))
+        );
+    }
+}
